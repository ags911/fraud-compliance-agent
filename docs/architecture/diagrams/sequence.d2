# What the demo does today, over Server-Sent Events.
# A sequence diagram cannot be stacked vertically, because its actors run across
# the page, so it keeps the scale by keeping its labels short.
...@_shared

shape: sequence_diagram

console: "Console"
api: "Demo API"
controls: "Controls"
investigation: "Investigator"
evidence: "Evidence"

console -> api: "1 POST /run"
api -> controls: "2 fixture facts"
controls -> api: "3 score, reasons" { style.stroke-dash: 4 }
controls."a hard control\nends the run"
api -> investigation: "4 if eligible"
investigation -> api: "5 result or\nfail-safe HOLD" { style.stroke-dash: 4 }
investigation."provider down:\nHOLD, never PASS"
api -> evidence: "6 signed record"
api -> console: "7 events, then done" { style.stroke-dash: 4 }
