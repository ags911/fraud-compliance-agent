# Deployment: from a developer's machine to the verified Azure showcase.
...@_shared

direction: down

dev: "Developer\nmake check" { class: built }
gh: "GitHub" { class: built }
ci: "Actions\nweb build, API tests, notebook policy,\ncontainer build, dependency audit, CodeQL" { class: built }
image: "API image\ndigest-pinned, non-root,\nno private SDK" { class: built }
azure: "Azure public showcase" {
  class: group
  grid-columns: 2
  swa: "Static Web Apps\nFree console" { class: built }
  aca: "Container Apps\nscale-to-zero API" { class: built }
}

dev -> gh -> ci
ci -> image
image -> azure: "protected OIDC workflow;\nBicep what-if, deploy,\nand public acceptance"
