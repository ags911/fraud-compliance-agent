# System context: who uses the engine and what it talks to.
...@_shared

direction: down

people: "People" {
  class: group
  grid-columns: 2
  operator: "Fraud operator" { class: built }
  reviewer: "Fraud reviewer" { class: planned }
  admin: "Administrator /\nmodel approver" { class: planned }
  visitor: "Recruiter or\nengineer" { class: built }
}

sources: "Data sources" {
  class: group
  grid-columns: 1
  provider: "Payment provider\nno adapter selected" { class: proposed }
  plaid: "Plaid Sandbox\nnotebooks only" { class: built }
  sparkov: "Sparkov corpus\noffline benchmark" { class: built }
}

engine: "Payment risk engine\ndecision engine + operator console\nsynthetic showcase" { class: focus }

services: "Services" {
  class: group
  grid-columns: 3
  groq: "Groq API\neligible cases only" { class: built }
  arbiris: "Arbiris\nreceives evidence" { class: built }
  azure: "Azure\nhosts the showcase" { class: planned }
}

people -> engine
sources -> engine: "sanitised or offline,\nnever a live input" { style.stroke-dash: 4 }
engine -> services

legend: "Legend" {
  near: bottom-center
  style.fill: transparent
  style.stroke: transparent
  b: "Built" { class: built }
  p: "Planned" { class: planned }
  x: "Proposed" { class: proposed }
}
