# Optional local-only provider path. Public/default runs force the deterministic
# provider-unavailable path and make no Groq request. Opt in deliberately.
GROQ_API_KEY=
DEMO_ALLOW_EXTERNAL_INVESTIGATION=false

# Required only for the Phase 0 Plaid Sandbox mapping notebook/integration.
# Keep real values in the ignored local .env or deployment secret manager.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Comma-separated list of origins allowed to call this API (CORS)
ALLOWED_ORIGINS=http://localhost:5173

# Public-demo safeguards. Queueing and execution share the timeout.
DEMO_MAX_CONCURRENT_RUNS=2
DEMO_RUN_TIMEOUT_SECONDS=60

# Optional — pin an ECDSA P-256 signing key (PEM). Unset = a fresh ephemeral
# key is generated per process start (fine for a demo; signatures still
# verify within that process, just won't match across restarts).
# ARBIRIS_LOCAL_SIGNING_KEY_PATH=

# Optional — cosmetic fields on the signed records
FIRM_ID=1234567890
ACCOUNTABLE_SMF=SMF-FRAUD-001
